	sub = Color3.fromRGB(152, 160, 184),
	dim = Color3.fromRGB(100, 108, 132),
	ok = Color3.fromRGB(74, 222, 155),
	warn = Color3.fromRGB(245, 185, 76),
	err = Color3.fromRGB(255, 107, 122),
	scroll = Color3.fromRGB(42, 47, 64),
}

local T = {}
for k, v in pairs(DEFAULT_T) do T[k] = v end

local ACCENTS = {
	Violet = Color3.fromRGB(139, 108, 255),
	Ocean = Color3.fromRGB(64, 160, 255),
	Mint = Color3.fromRGB(52, 214, 168),
	Rose = Color3.fromRGB(255, 94, 145),
	Amber = Color3.fromRGB(255, 176, 64),
}

local function shift(c)
	local h, s, v = c:ToHSV()
	return Color3.fromHSV((h + 0.09) % 1, s, v)
end

local accent = ACCENTS.Violet
local accent2 = shift(accent)
local savedAccent = accent
local hooks = {}
local themeHooks = {}
local isRainbowAccent = false

local function onAccent(fn)
	table.insert(hooks, fn)
	fn(accent, accent2)
end

local function onThemeChange(fn)
	table.insert(themeHooks, fn)
end

function Aurora:SetAccent(c, save)
	if type(c) == "string" then c = ACCENTS[c] end
	if typeof(c) ~= "Color3" then return end
	accent, accent2 = c, shift(c)
	if save then savedAccent = c end
	for _, fn in ipairs(hooks) do fn(accent, accent2) end
end

function Aurora:UpdateThemeColor(key, col)
	T[key] = col
	for _, fn in ipairs(themeHooks) do fn(key, col) end
end

function Aurora:ResetTheme()
	for k, v in pairs(DEFAULT_T) do
		T[k] = v
		for _, fn in ipairs(themeHooks) do fn(k, v) end
	end
	Aurora:SetAccent(ACCENTS.Violet, true)
end

------------------------------------------------------------------ YARDIMCILAR
local function tween(o, t, p, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), p)
	tw:Play()
	return tw
end

local function new(class, props, kids)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	for _, c in ipairs(kids or {}) do c.Parent = o end
	return o
end

local function corner(r) return new("UICorner", { CornerRadius = UDim.new(0, r) }) end
local function stroke(c, t, tr)
	return new("UIStroke", { Color = c or T.line, Thickness = t or 1, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function pad(l, t, r, b)
	return new("UIPadding", { PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r), PaddingBottom = UDim.new(0, b) })
end
local function list(gap)
	return new("UIListLayout", { Padding = UDim.new(0, gap or 8), SortOrder = Enum.SortOrder.LayoutOrder })
end
local function label(p)
	p.BackgroundTransparency = 1
	p.Font = p.Font or Enum.Font.GothamMedium
	p.TextColor3 = p.TextColor3 or T.text
	p.TextSize = p.TextSize or 13
	p.TextXAlignment = p.TextXAlignment or Enum.TextXAlignment.Left
	local l = new("TextLabel", p)
	onThemeChange(function(k, c)
		if k == "text" and (p.TextColor3 == T.text or p.TextColor3 == nil) then l.TextColor3 = c end
		if (k == "sub" or k == "dim") and (p.TextColor3 == T.sub or p.TextColor3 == T.dim) then l.TextColor3 = c end
	end)
	return l
end
local function accentGrad(parent, rot)
	local g = new("UIGradient", { Rotation = rot or 0 })
	onAccent(function(a, b) g.Color = ColorSequence.new(a, b) end)
	g.Parent = parent
	return g
end

local function makeDrag(track, fn)
	local dragging = false
	track.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fn(math.clamp((i.Position.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1))
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			fn(math.clamp((i.Position.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1))
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
end

