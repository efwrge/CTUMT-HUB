				hover(r)
				label({ Text = t, Size = UDim2.new(1, -80, 1, 0), Position = UDim2.fromOffset(14, 0), TextColor3 = T.text }).Parent = r
				local pill = new("TextButton", { Text = "", Size = UDim2.fromOffset(42, 22), Position = UDim2.new(1, -56, 0.5, -11), BackgroundColor3 = Color3.new(1, 1, 1), AutoButtonColor = false, BorderSizePixel = 0 }, { corner(11) })
