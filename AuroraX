		btn.MouseEnter:Connect(function() if current ~= name then tween(bg, 0.15, { BackgroundTransparency = 0.93 }) end end)
		btn.MouseLeave:Connect(function() if current ~= name then tween(bg, 0.15, { BackgroundTransparency = 1 }) end end)
