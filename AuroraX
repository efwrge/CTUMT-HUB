	YOffset = 0,
	Prediction = false,
	PredStrength = 0.1,
	FOV = 150,
	ShowFOV = AIM_MOBILE, -- mobilde FOV dairesi ekran ortasinda gorunsun
	ShowButton = true,
	ButtonSize = AIM_MOBILE and 72 or 58,
	FOVColor = Color3.fromRGB(139, 108, 255),
	MaxDistance = 1000,
	TeamCheck = false,
	WallCheck = false,
	Sticky = true,
}

local holding, latched, aimTarget = false, false, false
local btnHold = false -- ekrandaki aim butonu basili mi
local fovCircle = new("Frame", {
	Name = "AimFOV", AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, BorderSizePixel = 0,
	Size = UDim2.fromOffset(300, 300), Visible = false, ZIndex = 5,
