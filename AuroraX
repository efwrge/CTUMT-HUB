	for i = 1, 14 do l[i] = newFrame(p, 3, {AnchorPoint = Vector2.new(.5, .5), BackgroundColor3 = WHITE, BackgroundTransparency = .1, Size = UDim2.fromOffset(1, 1)}) end
	return {list = l}
end

local function buildArrow(p)
	local t = makeLabel(p, 7); t.Text = '▲'; t.TextSize = 22; t.AnchorPoint = Vector2.new(.5, .5); t.Size = UDim2.fromOffset(26, 26)
	return {list = {t}, label = t}
end

local function grp(d, key, build)
	local g = d.g[key]
	if not g then g = build(d.gui); d.g[key] = g end
	return g
end

local function measure(d)
	local r = d.root
	local ok, cf, size = pcall(function() return d.model:GetBoundingBox() end)
	local off, sx, sy, sz = CFrame.new(), 4, 6, 2
	if ok and cf and size and finite(size.X) and finite(size.Y) and finite(size.Z) then
		local o = r.CFrame:ToObjectSpace(cf)
		if o.Position.Magnitude < 8 then
			off = o; sx = math.clamp(size.X + .2, 2, 7); sy = math.clamp(size.Y + .2, 3, 10); sz = math.clamp(size.Z + .2, 1.5, 7)
		end
	end
	local ns = Vector3.new(sx, sy, sz)
	if d.boxSize then ns = d.boxSize:Lerp(ns, .35); off = d.boxOff:Lerp(off, .35) end
	d.boxSize, d.boxOff = ns, off
	d.carrier.Size = ns
	local cy = (r.CFrame * off).Position.Y
	d.up = math.clamp(cy + ns.Y * .5 - r.Position.Y, 1, 8)
	d.down = math.clamp(r.Position.Y - (cy - ns.Y * .5), 1, 8)
	d.ratio = math.clamp(ns.X * .8 / ns.Y, .38, .62)
end

local function buildBones(d)
	local m = d.model
	local list = m:FindFirstChild('UpperTorso') and R15 or R6
	local out = {}
	for _, pr in ipairs(list) do
		local a, b = m:FindFirstChild(pr[1]), m:FindFirstChild(pr[2])
		if a and b and a:IsA('BasePart') and b:IsA('BasePart') then out[#out + 1] = {a, b} end
	end
	d.bp = out
end

local function toolInfo(model, player)
	local held, count, order = 'Yok', {}, {}
	local function scan(c)
		if not c then return end
		for _, t in ipairs(c:GetChildren()) do
			if t:IsA('Tool') then
				if c == model and held == 'Yok' then held = t.Name end
				if not count[t.Name] then count[t.Name] = 0; order[#order + 1] = t.Name end
				count[t.Name] = count[t.Name] + 1
			end
		end
	end
	scan(model)
	if player then scan(player:FindFirstChildOfClass('Backpack')) end
	local parts = {}
	for i = 1, math.min(4, #order) do local n = order[i]; parts[#parts + 1] = count[n] > 1 and (n .. ' x' .. count[n]) or n end
	if #order > 4 then parts[#parts + 1] = '+' .. (#order - 4) end
	return held, #parts > 0 and table.concat(parts, ', ') or 'Boş'
end

local function canSee(d, cam)
	local o = cam.CFrame.Position
	local parts = {d.root, d.model:FindFirstChild('Head')}
	for i = 1, 2 do
		local p = parts[i]
		if p and p:IsA('BasePart') then
			local hit = workspace:Raycast(o, p.Position - o, vParams)
			if not hit or hit.Instance:IsDescendantOf(d.model) then return true end
		end
	end
	return false
end

local function createESP(model, player)
	local hm = model:FindFirstChildOfClass('Humanoid')
	local rt = model:FindFirstChild('HumanoidRootPart') or model.PrimaryPart or model:FindFirstChild('Head')
	if not hm or not rt or not rt:IsA('BasePart') then return nil end
	local d = {model = model, player = player, hum = hm, root = rt, g = {}, active = false, visible = true, dist = 0, color = ESP.Color, hp = 1, hpNum = 0, nameText = '', distText = '', itemText = '', itemLines = 0, mStamp = 0, iStamp = 0, hlOK = true, up = 3, down = 3, ratio = .55}
	d.gui = esp_make('Frame', {BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Active = false, ZIndex = 1}, overlay)
	d.carrier = esp_make('Part', {Name = 'KPUD_ESP_BOX', Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false, CastShadow = false, Transparency = 1, Size = Vector3.new(4, 6, 2)}, world)
	d.box3 = esp_make('SelectionBox', {Name = 'KPUD_ESP_3D', Adornee = d.carrier, Color3 = ESP.Color, SurfaceTransparency = 1, LineThickness = .04, Visible = false}, world)
	d.hl = esp_make('Highlight', {Name = 'KPUD_ESP_HL', Adornee = model, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, FillTransparency = .86, OutlineTransparency = .1, FillColor = ESP.Color, OutlineColor = ESP.Color, Enabled = false}, world)
	measure(d); d.mStamp = os.clock()
	targets[model] = d
	return d
end

local function dropESP(model)
	local d = targets[model]
	if not d then return end
	targets[model] = nil
	pcall(function() d.gui:Destroy(); d.carrier:Destroy(); d.box3:Destroy(); d.hl:Destroy() end)
end

local function clearAllESP()
	local l = {}
	for m in pairs(targets) do l[#l + 1] = m end
	for _, m in ipairs(l) do dropESP(m) end
end

local function hideTarget(d)
	for _, g in pairs(d.g) do show(g, false) end
	if d.box3.Visible then d.box3.Visible = false end
	if d.hl.Enabled then d.hl.Enabled = false end
end

local function addNPC(h)
	local m = h and h.Parent
	if m and m:IsA('Model') and m ~= lp.Character and not Players:GetPlayerFromCharacter(m) then npcs[m] = true end
end
workspace.DescendantAdded:Connect(function(o) if ESP.NPC and o:IsA('Humanoid') then task.defer(addNPC, o) end end)

local function slowESP()
	local cam, mine = workspace.CurrentCamera, lp.Character and lp.Character:FindFirstChild('HumanoidRootPart')
	if not (ESP.Player or ESP.NPC) or not mine or not cam then
		if next(targets) then clearAllESP() end
		return
	end
	vParams.FilterDescendantsInstances = lp.Character and {lp.Character, world} or {world}
	local now = os.clock()
	local seen = {}
	local needVis = ESP.VisibleCheck or ESP.VisColor
	local needItems = ESP.HeldItem or ESP.Inventory

	local function consider(model, player)
		if not model or not model.Parent then return end
		local d = targets[model]
		local hm = d and d.hum or model:FindFirstChildOfClass('Humanoid')
		if not hm or hm.Health <= 0 then return end
		local rt = d and d.root or model:FindFirstChild('HumanoidRootPart') or model.PrimaryPart or model:FindFirstChild('Head')
		if not rt or not rt:IsA('BasePart') or not rt.Parent then return end
		if player and ESP.TeamCheck and lp.Team and player.Team == lp.Team then return end
		local dist = (rt.Position - mine.Position).Magnitude
		if dist > (d and ESP.Range * 1.04 or ESP.Range) then return end
		d = d or createESP(model, player)
		if not d then return end
		seen[model] = true
		d.dist = dist; d.hum = hm; d.player = player
		d.visible = (not needVis) or canSee(d, cam)
		d.active = not (ESP.VisibleCheck and not d.visible)
		local c = ESP.Color
		if ESP.TeamColor and player and player.Team then c = player.TeamColor.Color end
		if ESP.VisColor then c = d.visible and GREEN or RED end
		d.color = c
		d.hp = math.clamp(hm.Health / math.max(hm.MaxHealth, 1), 0, 1)
		d.hpNum = math.floor(hm.Health + .5)
		d.distText = string.format('%d st', math.floor(dist + .5))
		d.nameText = player and player.DisplayName or model.Name
		if now - d.mStamp > .4 then d.mStamp = now; measure(d); if ESP.Skeleton then buildBones(d) end end
		if needItems then
			if now - d.iStamp > .5 then
				d.iStamp = now
				local held, inv = toolInfo(model, player)
				local lines = {}
				if ESP.HeldItem then lines[#lines + 1] = 'ELDE: ' .. held end
				if ESP.Inventory then lines[#lines + 1] = 'ÇANTA: ' .. inv end
				d.itemText = table.concat(lines, '\n'); d.itemLines = #lines
			end
		else
			d.itemText = ''; d.itemLines = 0
		end
	end

	if ESP.Player then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= lp and p.Character then consider(p.Character, p) end
		end
	end
	if ESP.NPC then
		for m in pairs(npcs) do
			if not m:IsDescendantOf(workspace) or Players:GetPlayerFromCharacter(m) then npcs[m] = nil else consider(m, nil) end
		end
	end

	local stale = {}
	for m in pairs(targets) do if not seen[m] then stale[#stale + 1] = m end end
	for _, m in ipairs(stale) do dropESP(m) end
end

local function drawArrow(d, camCF, c)
	if not ESP.Arrows then show(d.g.arrow, false) return end
	local rel = camCF:PointToObjectSpace(d.root.Position)
	local dir = Vector2.new(rel.X, -rel.Y)
	if dir.Magnitude < .01 then dir = Vector2.new(0, 1) end
	dir = dir.Unit
	local g = grp(d, 'arrow', buildArrow)
	local rad = math.min(VW, VH) * .42
	g.label.Position = UDim2.fromOffset(VW * .5 + dir.X * rad, VH * .5 + dir.Y * rad)
	g.label.Rotation = math.deg(math.atan2(dir.X, -dir.Y))
	g.label.TextColor3 = c
	show(g, true)
end

local function drawESP(d, cam, camCF)
	local r = d.root
	if not d.active or not r.Parent then hideTarget(d) return end
	local c = ESP.Rainbow and rainbow or d.color
	if ESP.Box3D then
		d.carrier.CFrame = r.CFrame * d.boxOff
		d.box3.Color3 = c; d.box3.LineThickness = .012 * ESP.Thickness + .015
		if not d.box3.Visible then d.box3.Visible = true end
	elseif d.box3.Visible then
		d.box3.Visible = false
	end

	local hlOn = ESP.Highlight and d.hlOK
	if d.hl.Enabled ~= hlOn then d.hl.Enabled = hlOn end
	if hlOn then d.hl.FillColor = c; d.hl.OutlineColor = c end

	local pos = r.Position
	local top = cam:WorldToViewportPoint(pos + Vector3.new(0, d.up, 0))
	local bot = cam:WorldToViewportPoint(pos - Vector3.new(0, d.down, 0))
	local front = top.Z > .2 and bot.Z > .2 and finite(top.X) and finite(top.Y) and finite(bot.X) and finite(bot.Y)
	local mx, y1, y2, x1, x2, w, h
	local onScr = false

	if front then
		mx = (top.X + bot.X) * .5
		y1 = math.min(top.Y, bot.Y); y2 = math.max(top.Y, bot.Y)
		h = y2 - y1; w = h * d.ratio; x1 = mx - w * .5; x2 = mx + w * .5
		onScr = h >= 2 and h < VH * 5 and x2 > -30 and x1 < VW + 30 and y2 > -30 and y1 < VH + 30
	end

	if ESP.Tracer and front then
		local g = grp(d, 'tracer', buildLine)
		local oy = (ESP.TracerFrom == 1 and VH) or (ESP.TracerFrom == 2 and VH * .5) or 0
		setLine(g.list[1], VW * .5, oy, mx, y2, c, 1.5)
	else
		show(d.g.tracer, false)
	end

	if not onScr then
		for k, g in pairs(d.g) do if k ~= 'arrow' and k ~= 'tracer' then show(g, false) end end
		drawArrow(d, camCF, c)
		return
	end

	show(d.g.arrow, false)
	x1, y1, x2, y2 = math.floor(x1 + .5), math.floor(y1 + .5), math.floor(x2 + .5), math.floor(y2 + .5)
	mx = math.floor(mx + .5); w = x2 - x1; h = y2 - y1
	local far = h < 30 or d.dist > 300
	local ts = ESP.TextSize
	if far then ts = math.max(8, ts - 2) end

	if ESP.Box then
		local g = grp(d, 'box', buildBox)
		local th = math.max(1, ESP.Thickness * .5)
		g.out.Position = UDim2.fromOffset(x1, y1); g.out.Size = UDim2.fromOffset(w, h)
		g.main.Position = UDim2.fromOffset(x1, y1); g.main.Size = UDim2.fromOffset(w, h)
		g.st.Color = c; g.st.Thickness = th
		g.main.BackgroundColor3 = c; g.main.BackgroundTransparency = ESP.Fill and .87 or 1
		show(g, true)
	else
		show(d.g.box, false)
	end

	if ESP.Corners then
		local g = grp(d, 'corners', buildCorners)
		local l = g.list
		local lx = math.clamp(math.floor(w * .28), 4, 24)
		local ly = math.clamp(math.floor(h * .2), 4, 24)
		local t = math.max(2, math.floor(ESP.Thickness * .7))
		put(l[1], x1, y1, lx, t, c); put(l[2], x1, y1, t, ly, c)
		put(l[3], x2 - lx, y1, lx, t, c); put(l[4], x2 - t, y1, t, ly, c)
		put(l[5], x1, y2 - t, lx, t, c); put(l[6], x1, y2 - ly, t, ly, c)
		put(l[7], x2 - lx, y2 - t, lx, t, c); put(l[8], x2 - t, y2 - ly, t, ly, c)
		show(g, true)
	else
		show(d.g.corners, false)
	end

	if ESP.Health and not far and h >= 26 then
		local g = grp(d, 'hp', buildHP)
		g.track.Position = UDim2.fromOffset(x1 - 7, y1); g.track.Size = UDim2.fromOffset(3, h)
		g.fill.Size = UDim2.fromScale(1, d.hp); g.fill.BackgroundColor3 = healthColor(d.hp)
		show(g, true)
	else
		show(d.g.hp, false)
	end

	if ESP.Name then
		local g = grp(d, 'name', buildLabel)
		local t = g.label
		t.Size = UDim2.fromOffset(240, ts + 4); t.Position = UDim2.fromOffset(mx - 120, y1 - ts - 6); t.TextSize = ts
		if t.Text ~= d.nameText then t.Text = d.nameText end
		show(g, true)
	else
		show(d.g.name, false)
	end

	local by = y2 + 2
	if ESP.Distance then
		local g = grp(d, 'dist', buildLabel)
		local t = g.label
		t.Size = UDim2.fromOffset(160, ts + 2); t.Position = UDim2.fromOffset(mx - 80, by); t.TextSize = ts - 1; t.TextColor3 = c
		if t.Text ~= d.distText then t.Text = d.distText end
		show(g, true); by = by + ts + 1
	else
		show(d.g.dist, false)
	end

	if ESP.Skeleton and d.dist <= 350 and h >= 34 and d.bp then
		local g = grp(d, 'skel', buildSkel)
		table.clear(pcache)
		for i = 1, #g.list do
			local ln, pr = g.list[i], d.bp[i]
			if pr and pr[1].Parent and pr[2].Parent then
				local pa = pcache[pr[1]]
				if not pa then pa = cam:WorldToViewportPoint(pr[1].Position); pcache[pr[1]] = pa end
				local pb = pcache[pr[2]]
				if not pb then pb = cam:WorldToViewportPoint(pr[2].Position); pcache[pr[2]] = pb end
				if pa.Z > .2 and pb.Z > .2 then setLine(ln, pa.X, pa.Y, pb.X, pb.Y, c, 1.5) else ln.Visible = false end
			else
				ln.Visible = false
			end
		end
	else
		show(d.g.skel, false)
	end
end

RunService:BindToRenderStep('KPUD_PURE_ESP_RENDER', Enum.RenderPriority.Camera.Value + 20, function(dt)
	slowTimer = slowTimer + dt
	if slowTimer >= .12 then
		slowTimer = 0
		pcall(slowESP)
	end
	local cam = workspace.CurrentCamera
