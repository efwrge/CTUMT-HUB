local AIM_MOBILE = UIS.TouchEnabled and not UIS.MouseEnabled -- saf dokunmatik cihaz (telefon/tablet)
local AimButton = {}
local Aim = {
	Enabled = false,
	Mode = AIM_MOBILE and "Toggle" or "Hold", -- mobilde dokun-ac/kapat, PC'de basili tut
	Key = { kind = "mouse", value = Enum.UserInputType.MouseButton2 },
	Part = "Head",
	Priority = "Closest to cursor",
