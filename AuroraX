				local tb = new("TextBox", { Size = UDim2.new(0.5, -20, 0, 26), Position = UDim2.new(0.5, 6, 0.5, -13), BackgroundColor3 = T.bg1, BackgroundTransparency = 0.3, BorderSizePixel = 0, Text = "", PlaceholderText = placeholder or "...", PlaceholderColor3 = T.dim, TextColor3 = T.text, Font = Enum.Font.Gotham, TextSize = 12, ClearTextOnFocus = false }, { corner(8), pad(10, 0, 10, 0), stroke(T.line, 1, 0.3) })
