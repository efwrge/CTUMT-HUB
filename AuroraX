	local current, firstName
	local function selectTab(name)
		current = name
		for n, p in pairs(tabs) do
			if n ~= name then p.Visible = false end
		end
		local p = tabs[name]
		p.Position = UDim2.fromOffset(0, 14)
		p.Visible = true
		tween(p, 0.35, { Position = UDim2.fromOffset(0, 0) })
		for n, b in pairs(tabBtns) do
			local on = n == name
			b.bg.BackgroundColor3 = accent
			tween(b.bg, 0.25, { BackgroundTransparency = on and 0.82 or 1 })
			tween(b.text, 0.25, { TextColor3 = on and T.text or T.sub })
			tween(b.glyph, 0.25, { TextColor3 = on and accent or T.dim })
			tween(b.bar, 0.3, { Size = UDim2.fromOffset(3, on and 20 or 0), Position = UDim2.fromOffset(-12, on and 10 or 20) })
		end
	end

	onThemeChange(function()
		if current then
			for n, b in pairs(tabBtns) do
				local on = n == current
				b.bg.BackgroundColor3 = accent
				b.bg.BackgroundTransparency = on and 0.82 or 1
				b.text.TextColor3 = on and T.text or T.sub
				b.glyph.TextColor3 = on and accent or T.dim
			end
		end
	end)

