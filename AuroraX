				sw.Parent = head
				local function apply()
					local c = Color3.fromHSV(h, s, v)
					sw.BackgroundColor3 = c
					if cb then cb(c) end
				end
				local function bar(y, seq, onRel)
					local tr = new("Frame", { Size = UDim2.new(1, -28, 0, 10), Position = UDim2.fromOffset(14, y), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, { corner(5), new("UIGradient", { Color = seq }) })
