local notifN = 0
function Aurora:Notify(title, body, duration, kind)
	if not notifHolder.Parent then return end
	duration = duration or 4
	notifN = notifN + 1
	local col = ({ success = T.ok, warn = T.warn, error = T.err })[kind]
	local glyph = ({ success = "+", warn = "!", error = "X" })[kind] or "i"

	local holder = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = notifN })
	local card = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(1.3, 0, 0, 0), BackgroundColor3 = T.card, BorderSizePixel = 0 }, {
		corner(14), pad(14, 12, 14, 12), list(8),
	})
	onThemeChange(function(k, c) if k == "card" then card.BackgroundColor3 = c end end)
	local edge = stroke(T.line)
	edge.Parent = card
	if col then edge.Color = col else onAccent(function(a) edge.Color = a end) end
	edge.Transparency = 0.35

	local head = new("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = 1 })
	local ic = new("Frame", { Size = UDim2.fromOffset(34, 34), BackgroundColor3 = col or accent, BorderSizePixel = 0 }, { corner(10) })
	if not col then onAccent(function(a) ic.BackgroundColor3 = a end) end
	ic.Parent = head
	label({ Text = glyph, Font = Enum.Font.GothamBlack, TextSize = 16, TextColor3 = Color3.new(1, 1, 1), TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1) }).Parent = ic
	label({ Text = title, Font = Enum.Font.GothamBold, TextSize = 13, Size = UDim2.new(1, -46, 0, 16), Position = UDim2.fromOffset(46, 1) }).Parent = head
	label({ Text = body, TextSize = 12, TextColor3 = T.sub, TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, -46, 0, 14), Position = UDim2.fromOffset(46, 19) }).Parent = head
	head.Parent = card

	local track = new("Frame", { Size = UDim2.new(1, 0, 0, 3), BackgroundColor3 = T.row2, BorderSizePixel = 0, LayoutOrder = 2 }, { corner(2) })
	onThemeChange(function(k, c) if k == "row2" then track.BackgroundColor3 = c end end)
	local bar = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = col or accent, BorderSizePixel = 0 }, { corner(2) })
	if not col then onAccent(function(a) bar.BackgroundColor3 = a end) end
	bar.Parent = track
	track.Parent = card

	card.Parent = holder
	holder.Parent = notifHolder
	tween(card, 0.45, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Back)
	tween(bar, duration, { Size = UDim2.new(0, 0, 1, 0) }, Enum.EasingStyle.Linear)
	task.delay(duration, function()
		if not card.Parent then return end
		tween(card, 0.35, { Position = UDim2.new(1.3, 0, 0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In).Completed:Wait()
		holder:Destroy()
	end)
end

