			function Section:AddSlider(t, min, max, default, cb, step)
				step = step or 1
				local value = default or min
				local r = row(58, t)
				hover(r)
				label({ Text = t, Size = UDim2.new(1, -100, 0, 28), Position = UDim2.fromOffset(14, 4), TextColor3 = T.text }).Parent = r
				local vbox = new("Frame", { Size = UDim2.fromOffset(54, 22), Position = UDim2.new(1, -68, 0, 7), BackgroundColor3 = T.bg1, BackgroundTransparency = 0.3, BorderSizePixel = 0 }, { corner(7) })
				onThemeChange(function(k, c) if k == "bg1" then vbox.BackgroundColor3 = c end end)
				local val = label({ Text = tostring(value), Font = Enum.Font.Code, TextSize = 12, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1) })
				val.Parent = vbox
				vbox.Parent = r
				local track = new("Frame", { Size = UDim2.new(1, -28, 0, 6), Position = UDim2.fromOffset(14, 42), BackgroundColor3 = T.bg1, BorderSizePixel = 0 }, { corner(3) })
				onThemeChange(function(k, c) if k == "bg1" then track.BackgroundColor3 = c end end)
				local fill = new("Frame", { Size = UDim2.new((value - min) / (max - min), 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, { corner(3) })
				accentGrad(fill, 0)
				fill.Parent = track
				local knob = new("Frame", { Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(1, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, { corner(7) })
				local ks = stroke(accent, 3, 0.55)
				onAccent(function(a) ks.Color = a end)
				ks.Parent = knob
				knob.Parent = fill
				track.Parent = r
				local function setRel(rel, fire)
					value = math.floor((min + (max - min) * rel) / step + 0.5) * step
					value = math.clamp(value, min, max)
					local shown = step < 1 and string.format("%.2f", value) or tostring(value)
					val.Text = shown
					tween(fill, 0.08, { Size = UDim2.new((value - min) / (max - min), 0, 1, 0) })
					if fire and cb then cb(value) end
				end
				makeDrag(track, function(rel) setRel(rel, true) end)
				return { Set = function(v) setRel((v - min) / (max - min), true) end }
			end

			function Section:AddDropdown(t, options, default, cb)
