		onAccent(function(a) bg.BackgroundColor3 = a end)
		bg.Parent = btn
		local bar = new("Frame", { Size = UDim2.fromOffset(3, 0), Position = UDim2.fromOffset(-12, 20), BackgroundColor3 = accent, BorderSizePixel = 0 }, { corner(2) })
		onAccent(function(a) bar.BackgroundColor3 = a end)
		bar.Parent = btn
		local g = label({ Text = "", Font = Enum.Font.GothamBold, TextSize = 15, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(34, 40), Position = UDim2.fromOffset(4, 0) })
		g.Parent = btn
		local tx = label({ Text = name, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = T.sub, Size = UDim2.new(1, -44, 1, 0), Position = UDim2.fromOffset(40, 0) })
		tx.Parent = btn
