		Visible = false, ZIndex = 40,
	}, { new("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	local btnScale = new("UIScale", { Scale = 1 })
	btnScale.Parent = aimBtn
	local ring = stroke(accent, 2, 0.1)
	onAccent(function(a) ring.Color = a end)
	ring.Parent = aimBtn

	local fillF = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 41 }, { new("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	accentGrad(fillF, 45)
	fillF.Parent = aimBtn

	local mainL = new("TextLabel", {
		Text = "AIM", Font = Enum.Font.GothamBlack, TextScaled = true, BackgroundTransparency = 1, TextColor3 = T.text,
		Size = UDim2.fromScale(0.8, 0.34), Position = UDim2.fromScale(0.1, 0.2), ZIndex = 42,
	}, { new("UITextSizeConstraint", { MaxTextSize = 17, MinTextSize = 8 }) })
	mainL.Parent = aimBtn
	local subL = new("TextLabel", {
		Text = "OFF", Font = Enum.Font.GothamBold, TextScaled = true, BackgroundTransparency = 1, TextColor3 = T.sub,
		Size = UDim2.fromScale(0.7, 0.2), Position = UDim2.fromScale(0.15, 0.56), ZIndex = 42,
	}, { new("UITextSizeConstraint", { MaxTextSize = 11, MinTextSize = 6 }) })
	subL.Parent = aimBtn
	aimBtn.Parent = gui

	local function viewport()
		local cam = workspace.CurrentCamera
		return cam and cam.ViewportSize or Vector2.new(1280, 720)
	end

	function AimButton.Reset()
		local vp = viewport()
		aimBtn.Position = UDim2.fromOffset(vp.X - 70, vp.Y * 0.6)
	end
	AimButton.Reset()

	local function clampPos(x, y)
		local vp = viewport()
		local half = Aim.ButtonSize / 2
		return math.clamp(x, half, math.max(half, vp.X - half)), math.clamp(y, half, math.max(half, vp.Y - half))
	end

	-- bas / surukle
	local pressed, dragged = false, false
	local startIn, startPos, moveInput = nil, Vector2.new(0, 0), nil
	local DRAG_THRESHOLD = 10

	aimBtn.InputBegan:Connect(function(i)
		if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end
		pressed, dragged = true, false
		startIn = i.Position
		moveInput = i
		startPos = Vector2.new(aimBtn.Position.X.Offset, aimBtn.Position.Y.Offset)
		tween(btnScale, 0.1, { Scale = 0.92 })
		-- Hold modu: kisa bir beklemeden sonra basili say (surukleme baslarsa iptal)
		task.delay(0.08, function()
			if pressed and not dragged and Aim.Mode == "Hold" then btnHold = true end
		end)
		i.Changed:Connect(function()
			if i.UserInputState == Enum.UserInputState.End and pressed then
				pressed = false
				tween(btnScale, 0.15, { Scale = 1 })
				if Aim.Mode == "Hold" then
					btnHold = false
				elseif Aim.Mode == "Toggle" and not dragged then
					latched = not latched
				end
			end
		end)
	end)
	aimBtn.InputChanged:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
			if not pressed then moveInput = i end
		end
	end)
	table.insert(conns, UIS.InputChanged:Connect(function(i)
		if not pressed or i ~= moveInput then return end
		if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
		local d = i.Position - startIn
		if not dragged and d.Magnitude >= DRAG_THRESHOLD then
			dragged = true
			btnHold = false
		end
		if dragged then
			local x, y = clampPos(startPos.X + d.X, startPos.Y + d.Y)
			aimBtn.Position = UDim2.fromOffset(x, y)
		end
	end))

	-- gorunum: aimbot acikken goster, duruma gore renk/yazi
	local wasShown, lastKey = false, ""
	table.insert(conns, RunService.Heartbeat:Connect(function()
		local show = Aim.Enabled and Aim.ShowButton
		if not Aim.Enabled then
			latched, btnHold = false, false
		end
		if show ~= wasShown then
			wasShown = show
			aimBtn.Visible = show
			if show then
				btnScale.Scale = 0
				tween(btnScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end
		if not show then return end
		local size = Aim.ButtonSize
		if aimBtn.Size.X.Offset ~= size then
			aimBtn.Size = UDim2.fromOffset(size, size)
		end
		local active = isAiming()
		local key = tostring(active) .. Aim.Mode
		if key ~= lastKey then
			lastKey = key
			tween(fillF, 0.2, { BackgroundTransparency = active and 0 or 1 })
			mainL.TextColor3 = active and Color3.new(1, 1, 1) or T.text
			subL.TextColor3 = active and Color3.new(1, 1, 1) or T.sub
			if Aim.Mode == "Always" then
				subL.Text = "ON"
			elseif Aim.Mode == "Toggle" then
				subL.Text = active and "ON" or "OFF"
			else
				subL.Text = active and "ON" or "HOLD"
			end
		end
	end))
end

